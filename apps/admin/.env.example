# Unified API (server-only & client fallback)
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public hosts — for cross-links in Admin UI
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VENDOR_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3002

# Optional Upstash Redis — shared /auth/me cache across serverless functions
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# PWA Push Notifications (Optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key_here

# Database connection (Required for scripts/create-admin.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/rvcc