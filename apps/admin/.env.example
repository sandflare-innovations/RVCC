# Admin portal (apps/admin) — never expose secrets to the browser.
# Dev: npm run dev → http://localhost:3001

ADMIN_API_URL=https://rvcc-admin-api.rvcc.workers.dev
ADMIN_API_SECRET=generate-a-long-random-secret

# --- Public hosts (no trailing slash) ---
NEXT_PUBLIC_SITE_URL=https://rvcc-prod.vercel.app
NEXT_PUBLIC_VENDOR_PORTAL_URL=https://rvcc-app.vercel.app
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://rvcc-admin.vercel.app

# Local override examples:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3001
# NEXT_PUBLIC_VENDOR_PORTAL_URL=http://localhost:3002

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rvcc?sslmode=require"
