# Admin portal (apps/admin) — never expose secrets to the browser.

# Cloudflare admin-api Worker
ADMIN_API_URL=https://rvcc-admin-api.rvcc.workers.dev
ADMIN_API_SECRET=generate-a-long-random-secret

# Same Postgres as Surface / workers (SSR reads for lists & detail pages)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rvcc?sslmode=require"
