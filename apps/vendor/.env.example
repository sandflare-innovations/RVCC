# Unified public app — marketing + registration + /portal
# Prod: https://rvcc-prod.vercel.app
# Dev: npm run dev → http://localhost:3000

API_URL=http://localhost:4000

# Cloudflare R2 public bucket (no trailing slash). App only renders — no uploads.
NEXT_PUBLIC_ASSET_CDN_URL=https://pub-placeholder.r2.dev
NEXT_PUBLIC_PDF_CDN_URL=https://pub-placeholder.r2.dev

# SITE_URL and VENDOR_PORTAL_URL are the same host (single public app).
NEXT_PUBLIC_SITE_URL=https://rvcc-prod.vercel.app
NEXT_PUBLIC_VENDOR_PORTAL_URL=https://rvcc-prod.vercel.app
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://rvcc-admin.vercel.app
