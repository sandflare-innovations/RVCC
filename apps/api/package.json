{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "RVCC unified API for admin, vendor, and supplier registration",
  "scripts": {
    "dev": "concurrently -n \"api,studio\" -c \"blue,green\" \"tsx watch --env-file-if-exists=.env src/index.ts\" \"prisma studio --port 5555\"",
    "db:studio": "prisma studio --port 5555",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "release": "node scripts/release.mjs",
    "cf:secret": "wrangler secret put"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "5.22.0",
    "@rvcc/schemas": "workspace:*",
    "@rvcc/types": "workspace:*",
    "aws4fetch": "^1.0.20",
    "hono": "^4.8.5",
    "nodemailer": "^9.0.4",
    "pg": "^8.23.0",
    "postgres": "^3.4.5",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.11",
    "concurrently": "^10.0.5",
    "prisma": "5.22.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=20"
  }
}
