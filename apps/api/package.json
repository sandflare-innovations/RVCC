{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "RVCC unified API for admin, vendor, and supplier registration",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "cf:secret": "wrangler secret put",
    "db:upgrade-sourcing": "node --env-file-if-exists=.env scripts/apply-sourcing-upgrade.mjs",
    "db:upgrade-uploads": "node --env-file-if-exists=.env scripts/apply-uploads-upgrade.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "aws4fetch": "^1.0.20",
    "hono": "^4.8.5",
    "nodemailer": "^9.0.4",
    "postgres": "^3.4.5",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=20"
  }
}
