# Server Configuration
PORT=4000
NODE_ENV=development

# Postgres Database (Required)
DATABASE_URL=postgresql://user:password@localhost:5432/rvcc
# Optional Read Replica for heavy SELECT queries
# DATABASE_READ_URL=postgresql://user:password@replica-host:5432/rvcc

# CORS — comma-separated frontend origins (no trailing slash). Never use * in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Public vendor portal host (used in email link generation)
VENDOR_PORTAL_URL=http://localhost:3001

# SMTP Email Configuration (Microsoft 365: smtp.office365.com:587)
# If the password contains #, set SMTP_PASS_B64 instead of SMTP_PASS.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# SMTP_PASS_B64=
SMTP_FROM="RVCC Procurement <procurement@example.com>"
ENQUIRE_FROM_EMAIL="RVCC Procurement <procurement@example.com>"

# Cloudflare R2 Uploads (Optional in local dev if not uploading files)
# S3 API: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com/{R2_BUCKET_NAME}
# API tokens are often scoped to one bucket. RFQ/KYC documents retry
# R2_SECURE_BUCKET_NAME, then R2_BUCKET_NAME, then rvcc-uploads.
R2_ACCOUNT_ID=d17302a485a00dcb8339cce02701183f
R2_BUCKET_NAME=rvcc-uploads
# R2_SECURE_BUCKET_NAME=rvcc-secure-assets
R2_PUBLIC_URL=https://pub-70b8c21f306842d3bbeab4d1d19319e1.r2.dev
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
