# Server
PORT=4000
NODE_ENV=development

# Postgres (required). Prefer Hyperdrive binding in production (see PERFORMANCE.md).
DATABASE_URL=postgresql://user:pass@host:5432/rvcc

# Optional read replica for dashboard aggregates
# DATABASE_READ_URL=postgresql://read-replica...

# Hyperdrive (production): create in Cloudflare dashboard, then uncomment:
# [[hyperdrive]]
# binding = "HYPERDRIVE"
# id = "<your-hyperdrive-config-id>"

# CORS — comma-separated frontend origins (no trailing slash). Never use *.
ALLOWED_ORIGINS=https://rvcc-enquiry.vercel.app,https://rvcc-vendor.vercel.app,https://rvcc-admin.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:3002

# Public vendor portal host (used in emails)
VENDOR_PORTAL_URL=https://rvcc-vendor.vercel.app
# Optional HMAC secret for email-gate tokens after OTP (defaults to DATABASE_URL)
# EMAIL_GATE_SECRET=generate-a-long-random-secret

# SMTP (enquire OTP, submission, decision, requirement mail)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ENQUIRE_FROM_EMAIL=RVCC Procurement <procurement@example.com>
