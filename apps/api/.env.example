# Server
PORT=4000
NODE_ENV=development

# Postgres (required)
DATABASE_URL=postgresql://user:pass@host:5432/rvcc

# CORS — comma-separated frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://rvcc-prod.vercel.app,https://rvcc-admin.vercel.app,http://localhost:3000,http://localhost:3001

# Public site URL used in approval / requirement emails (same host as marketing)
VENDOR_PORTAL_URL=https://rvcc-prod.vercel.app
# Optional HMAC secret for email-gate tokens after OTP (defaults to DATABASE_URL)
# EMAIL_GATE_SECRET=generate-a-long-random-secret

# SMTP (enquire OTP, submission, decision, requirement mail)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ENQUIRE_FROM_EMAIL=RVCC Procurement <procurement@example.com>
