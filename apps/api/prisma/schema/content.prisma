// =========================================================================
// CMS & CONTENT DOMAIN (HERO, CLIENTS, SISTER COMPANIES, PROJECTS, SERVICES)
// =========================================================================

model HeroSlide {
  id               String    @id @default(cuid())
  page             String    @default("home") // "home" | "about" | "services" | "projects" | "careers" | "clients" | "documents" | "quality-policy" | "contact" | "gallery"
  badge            String    @default("Architecture & Design")
  title1           String
  title2           String
  description      String
  imageUrl         String
  primaryBtnText   String?   @default("Explore Works")
  primaryBtnLink   String?   @default("#projects")
  secondaryBtnText String?   @default("E-Vendor Registration")
  secondaryBtnLink String?   @default("/enquire/verify")
  sortOrder        Int       @default(0)
  isActive         Boolean   @default(true)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  deletedAt        DateTime? // Soft Deletion

  @@index([page, isActive, sortOrder])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model ClientPartner {
  id         String    @id @default(cuid())
  name       String
  logoUrl    String
  industry   String    @default("General")
  websiteUrl String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime? // Soft Deletion

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model SisterCompany {
  id         String    @id @default(cuid())
  name       String
  logoUrl    String
  industry   String    @default("Sister Concern")
  websiteUrl String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime? // Soft Deletion

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model Project {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  category     String         @default("Commercial Architecture")
  serviceSlugs String[]       @default([]) // Links to services e.g. "cladding-works", "steel-metal-works"
  client       String         @default("")
  location     String         @default("Riyadh, KSA")
  year         String         @default("2024")
  status       String         @default("Completed") // "Completed" | "In Progress" | "Upcoming"
  description  String         @default("")
  coverImage   String         @default("")
  scope        String[]       @default([])
  sortOrder    Int            @default(0)
  isActive     Boolean        @default(true)

  gallery      GalleryImage[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  deletedAt    DateTime?      // Soft Deletion

  @@index([slug])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model GalleryImage {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl     String
  caption      String    @default("")
  serviceSlugs String[]  @default([]) // Explicit services connected to this photo
  isCover      Boolean   @default(false)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime? // Soft Deletion

  @@index([projectId, sortOrder])
  @@index([isActive])
  @@index([deletedAt])
}

model Service {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String    @default("")
  longDescription String    @default("")
  image           String    @default("")
  iconName        String    @default("Wrench")
  features        String[]  @default([])
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  deletedAt       DateTime? // Soft Deletion

  @@index([slug])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model NewsEvent {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  date        String    // e.g. "April 15, 2024"
  excerpt     String    @default("")
  content     String?   // optional full article body
  imageUrl    String
  category    String    @default("General")
  edition     String    @default("Vol. 24")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime? // Soft Deletion

  @@index([slug])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model AboutContent {
  id                    String   @id @default("default")
  videoUrl              String   @default("https://pub-70b8c21f306842d3bbeab4d1d19319e1.r2.dev/content/about/about.mp4")
  videoPosterUrl        String?
  homeStats             Json     @default("[]")
  aboutStats            Json     @default("[]")
  overviewImages        String[] @default([])
  overviewTitle         String   @default("The Art of Structural Perfection.")
  overviewSubtitle      String   @default("Company Profile")
  overviewDescription1  String   @default("Riyadh Villas Contracting Company (RVCC) stands as a beacon of refined engineering and timeless structural design. For nearly two decades, we have been the quiet force behind the Kingdom's most prestigious developments.")
  overviewDescription2  String   @default("Our philosophy is simple: perfection is not when there is nothing more to add, but when there is nothing left to take away. We bring this minimalist precision to every civil, structural, and engineering challenge we undertake.")
  classABadge           String   @default("Class A")
  classADescription     String   @default("Ministry Accredited Excellence")
  deliveriesCount       String   @default("150+")
  yearsCount            String   @default("20+")

  updatedAt             DateTime @default(now()) @updatedAt
}

