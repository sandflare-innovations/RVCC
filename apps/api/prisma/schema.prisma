datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// =========================================================================
// 1. ENUMS (Status Tracking, State Machines, Currencies & Security)
// =========================================================================

enum Currency {
  SAR
  USD
  AED
  INR
  EUR
}

enum LoginStatus {
  SUCCESS
  FAILED
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum RequirementStatus {
  DRAFT
  PENDING
  OPEN
  EVALUATING
  AWARDED
  CANCELLED
  REJECTED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum ProcurementPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PortalAccess {
  HELD
  RELEASED
}

enum BusinessRelationship {
  PROSPECTIVE
  SPEND_AUTHORIZED
}

enum NotificationType {
  REQUIREMENT_POSTED
  REQUIREMENT_UPDATED
  QUOTE_SUBMITTED
  QUOTE_AWARDED
}

// =========================================================================
// 2. RBAC DOMAIN (Role & Permission)
// =========================================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "SUPER_ADMIN", "PROCUREMENT_MANAGER", "VIEWER"
  description String   @default("")
  isSystem    Boolean  @default(false)

  admins      AdminUser[]
  permissions RolePermission[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. "procurement:approve", "vendors:read", "staff:manage"
  description String   @default("")
  category    String   @default("GENERAL")

  roles       RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model ExchangeRate {
  id         String   @id @default(cuid())
  currency   Currency @unique
  rateToSar  Decimal  @db.Decimal(12, 6)
  updatedAt  DateTime @default(now()) @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
}

// =========================================================================
// 3. USER ACCOUNTS, AUTHENTICATION & LOGIN HISTORY
// =========================================================================

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String    @default("")
  position       String    @default("")
  department     String    @default("")
  phone          String    @default("")
  passwordHash   String
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  // RBAC Link (Optional relation so existing admin records remain valid during transition)
  roleId         String?
  role           Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Throttling
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  deletedAt      DateTime? // Soft Deletion

  sessions       AdminSession[]
  otps           AdminOtp[]
  loginHistory   AdminLoginHistory[]
  auditLogs      AuditLog[]
  reviewedRegs   SupplierRegistration[]
  jobPostings    JobPosting[]
  requirements   Requirement[]          @relation("RequirementAuthor")
  awardedReqs    Requirement[]          @relation("RequirementAwarder")
  notifications  Notification[]
  purchaseReqs   PurchaseRequest[]
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([roleId])
  @@index([deletedAt])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  userAgent String    @default("")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

/// Strict foreign-key bound Admin OTP table
model AdminOtp {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String    @default("STAFF_MANAGEMENT") // e.g. "STAFF_MANAGEMENT", "PASSWORD_RESET"
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([adminId, action])
  @@index([expiresAt])
}

/// Tracks comprehensive staff authentication attempts and security telemetry
model AdminLoginHistory {
  id            String      @id @default(cuid())
  adminId       String
  admin         AdminUser   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ipAddress     String
  userAgent     String      @default("")
  status        LoginStatus
  failureReason String?     // e.g. "INVALID_CREDENTIALS", "ACCOUNT_LOCKED"
  loginAt       DateTime    @default(now())

  @@index([adminId, loginAt(sort: Desc)])
}

model VendorUser {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String               @default("")
  passwordHash       String
  mustChangePassword Boolean              @default(true)
  isActive           Boolean              @default(true)
  portalAccess       PortalAccess         @default(HELD)

  registrationId     String?
  registration       SupplierRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  failedAttempts     Int                  @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  deletedAt          DateTime?            // Soft Deletion

  sessions           VendorSession[]
  otps               VendorOtp[]
  loginHistory       VendorLoginHistory[]
  auditLogs          AuditLog[]
  industries         Industry[]
  invites            RequirementInvite[]
  quotes             Quote[]
  notifications      Notification[]

  @@index([email])
  @@index([portalAccess])
  @@index([deletedAt])
}

model VendorSession {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  vendorId  String
  vendor    VendorUser @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userAgent String     @default("")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([vendorId])
}

/// Strict foreign-key bound Vendor OTP table
model VendorOtp {
  id         String     @id @default(cuid())
  vendorId   String
  vendor     VendorUser @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  action     String     @default("REGISTRATION_VERIFY") // e.g. "LOGIN_VERIFY", "PASSWORD_RESET"
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([vendorId, action])
  @@index([expiresAt])
}

/// Tracks external vendor login telemetry and anomaly detection
model VendorLoginHistory {
  id            String      @id @default(cuid())
  vendorId      String
  vendor        VendorUser  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ipAddress     String
  userAgent     String      @default("")
  status        LoginStatus
  failureReason String?
  loginAt       DateTime    @default(now())

  @@index([vendorId, loginAt(sort: Desc)])
}

// =========================================================================
// 4. VENDOR ONBOARDING DOMAIN
// =========================================================================

model SupplierRegistration {
  id                   String               @id @default(cuid())
  referenceNumber      String?              @unique
  status               RegistrationStatus   @default(DRAFT)
  businessRelationship BusinessRelationship @default(PROSPECTIVE)
  email                String
  currentStep          String               @default("verify")
  sessionToken         String?              @unique
  registrationComplete Boolean              @default(false)

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt
  submittedAt          DateTime?
  deletedAt            DateTime?            // Soft Deletion

  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           AdminUser?           @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote           String?

  vendorUsers          VendorUser[]
  company              CompanyProfile?
  contacts             SupplierContact[]
  addresses            SupplierAddress[]
  classifications      BusinessClassification[]
  bankAccounts         BankAccount[]
  productCategories    String[]             @default([])
  questionnaire        QuestionnaireAnswer[]
  attachments          RegistrationAttachment[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
}

model CompanyProfile {
  id               String               @id @default(cuid())
  registrationId   String               @unique
  registration     SupplierRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  legalName        String               @default("")
  dbaName          String               @default("")
  country          String               @default("")
  taxIdentifiers   Json                 @default("{}")
  organizationType String               @default("")
  supplierType     String               @default("")
  website          String               @default("")
  yearEstablished  String               @default("")
  dunsNumber       String               @default("")
  description      String               @default("")

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  deletedAt        DateTime?            // Soft Deletion

  @@index([deletedAt])
}

model SupplierContact {
  id                 String               @id @default(cuid())
  registrationId     String
  registration       SupplierRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  firstName          String               @default("")
  lastName           String               @default("")
  email              String               @default("")
  jobTitle           String               @default("")
  phone              String               @default("")
  mobile             String               @default("")
  isAdministrative   Boolean              @default(false)
  requestUserAccount Boolean              @default(false)
  sortOrder          Int                  @default(0)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  deletedAt          DateTime?            // Soft Deletion

  @@index([registrationId])
  @@index([deletedAt])
}

model SupplierAddress {
  id             String               @id @default(cuid())
  registrationId String
  registration   SupplierRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  label          String               @default("")
  line1          String               @default("")
  line2          String               @default("")
  city           String               @default("")
  region         String               @default("")
  postalCode     String               @default("")
  country        String               @default("")
  phone          String               @default("")
  email          String               @default("")
  purposes       String[]             @default([])
  sortOrder      Int                  @default(0)

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt
  deletedAt      DateTime?            // Soft Deletion

  @@index([registrationId])
  @@index([deletedAt])
}

model BusinessClassification {
  id                String               @id @default(cuid())
  registrationId    String
  registration      SupplierRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  classification    String               @default("")
  certificateNumber String               @default("")
  certifyingAgency  String               @default("")
  effectiveDate     String               @default("")
  expirationDate    String               @default("")
  sortOrder         Int                  @default(0)

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
  deletedAt         DateTime?            // Soft Deletion

  @@index([registrationId])
  @@index([deletedAt])
}

model BankAccount {
  id             String               @id @default(cuid())
  registrationId String
  registration   SupplierRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  country        String               @default("")
  bankName       String               @default("")
  branchName     String               @default("")
  accountName    String               @default("")
  accountNumber  String               @default("")
  iban           String               @default("")
  routingNumber  String               @default("")
  currency       Currency             @default(SAR)
  sortOrder      Int                  @default(0)

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt
  deletedAt      DateTime?            // Soft Deletion

  @@index([registrationId])
  @@index([deletedAt])
}

model QuestionnaireAnswer {
  id             String               @id @default(cuid())
  registrationId String
  registration   SupplierRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  questionKey    String
  answer         String               @default("")

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  @@unique([registrationId, questionKey])
  @@index([registrationId])
}

model RegistrationAttachment {
  id             String               @id @default(cuid())
  registrationId String
  registration   SupplierRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  section        String
  fileName       String
  fileUrl        String
  mimeType       String               @default("")

  createdAt      DateTime             @default(now())
  deletedAt      DateTime?            // Soft Deletion

  @@index([registrationId])
  @@index([deletedAt])
}

// =========================================================================
// 5. SOURCING & RFQ DOMAIN (Strict Currency Enum & Non-Cascading Deletes)
// =========================================================================

model Requirement {
  id               String            @id @default(cuid())
  referenceNumber  String?           @unique
  scopeOfWork      String
  project          String
  sellingPrice     Decimal?          @db.Decimal(14, 2)
  currency         Currency          @default(SAR)

  closesAt         DateTime
  status           RequirementStatus @default(DRAFT)

  createdByAdminId String
  createdByAdmin   AdminUser         @relation("RequirementAuthor", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  awardedQuoteId   String?           @unique
  awardedQuote     Quote?            @relation("AwardedQuote", fields: [awardedQuoteId], references: [id], onDelete: SetNull)
  awardedAt        DateTime?
  awardedByAdminId String?
  awardedByAdmin   AdminUser?        @relation("RequirementAwarder", fields: [awardedByAdminId], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  deletedAt        DateTime?         // Soft Deletion

  invites          RequirementInvite[]
  quotes           Quote[]

  @@index([status, closesAt])
  @@index([deletedAt])
}

model RequirementInvite {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  vendorUserId  String
  vendorUser    VendorUser  @relation(fields: [vendorUserId], references: [id], onDelete: Restrict)

  emailStatus   String      @default("PENDING")
  emailError    String?
  emailedAt     DateTime?

  createdAt     DateTime    @default(now())

  @@unique([requirementId, vendorUserId])
  @@index([vendorUserId])
}

model Quote {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  vendorUserId  String
  vendorUser    VendorUser  @relation(fields: [vendorUserId], references: [id], onDelete: Restrict)

  // Multi-Currency Implementation
  currency      Currency    @default(SAR)
  exchangeRate  Decimal     @default(1.0) @db.Decimal(12, 6)
  newPrice      Decimal?    @db.Decimal(14, 2)
  amountSar     Decimal?    @db.Decimal(14, 2)

  remarks       String      @default("")
  status        QuoteStatus @default(DRAFT)
  submittedAt   DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  deletedAt     DateTime?   // Soft Deletion

  awardedFor    Requirement? @relation("AwardedQuote")
  revisions     QuoteRevision[]
  attachments   QuoteAttachment[]

  @@unique([requirementId, vendorUserId])
  @@index([requirementId, status])
  @@index([deletedAt])
}

model QuoteAttachment {
  id          String    @id @default(cuid())
  quoteId     String
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileSize    Int       @default(0)
  mimeType    String    @default("application/pdf")
  uploadedAt  DateTime  @default(now())

  @@index([quoteId])
}

model QuoteRevision {
  id            String      @id @default(cuid())
  quoteId       String
  quote         Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requirementId String
  vendorUserId  String
  currency      Currency    @default(SAR)
  exchangeRate  Decimal     @default(1.0) @db.Decimal(12, 6)
  price         Decimal?    @db.Decimal(14, 2)
  amountSar     Decimal?    @db.Decimal(14, 2)
  remarks       String      @default("")
  status        QuoteStatus @default(DRAFT)
  createdAt     DateTime    @default(now())

  @@index([quoteId])
  @@index([requirementId])
  @@index([vendorUserId])
  @@index([createdAt])
}

// =========================================================================
// 6. PROCUREMENT DOMAIN (Multi-Currency & Safe Soft Deletion)
// =========================================================================

model PurchaseRequest {
  id              String              @id @default(cuid())
  referenceNumber String              @unique
  title           String
  description     String              @default("")
  department      String
  requesterName   String
  requesterEmail  String?
  priority        ProcurementPriority @default(MEDIUM)
  status          ProcurementStatus   @default(DRAFT)
  requiredByDate  DateTime
  currency        Currency            @default(SAR)
  estimatedAmount Decimal             @default(0) @db.Decimal(14, 2)
  costCenter      String?
  adminNotes      String?

  createdById     String?
  createdBy       AdminUser?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt
  deletedAt       DateTime?           // Soft Deletion

  items           PurchaseRequestItem[]
  attachments     PurchaseRequestAttachment[]

  @@index([status, priority])
  @@index([department])
  @@index([deletedAt])
}

model PurchaseRequestItem {
  id                 String          @id @default(cuid())
  purchaseRequestId  String
  purchaseRequest    PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)

  name               String
  category           String
  quantity           Decimal         @db.Decimal(12, 2)
  unit               String

  // Multi-Currency Fields
  currency           Currency        @default(SAR)
  exchangeRate       Decimal         @default(1.0) @db.Decimal(12, 6)
  estimatedUnitPrice Decimal         @db.Decimal(14, 2)
  totalPrice         Decimal         @db.Decimal(14, 2)

  preferredVendor    String?
  notes              String?
  sortOrder          Int             @default(0)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt
  deletedAt          DateTime?       // Soft Deletion

  @@index([purchaseRequestId, sortOrder])
  @@index([deletedAt])
}

model PurchaseRequestAttachment {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)

  name              String
  url               String
  sizeBytes         Int             @default(0)
  mimeType          String          @default("application/pdf")

  uploadedAt        DateTime        @default(now())
  deletedAt         DateTime?       // Soft Deletion

  @@index([purchaseRequestId])
  @@index([deletedAt])
}

// =========================================================================
// 7. CROSS-CUTTING, MULTI-ACTOR AUDIT TRAIL & CMS
// =========================================================================

model Industry {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  isActive  Boolean      @default(true)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  vendors   VendorUser[]
}

model Notification {
  id           String      @id @default(cuid())
  vendorUserId String?
  vendorUser   VendorUser? @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)

  adminId      String?
  admin        AdminUser?  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  type         NotificationType
  title        String
  body         String           @default("")
  linkPath     String

  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([vendorUserId, readAt])
  @@index([adminId, readAt])
}

model PushSubscription {
  id        String     @id @default(cuid())
  endpoint  String     @unique
  p256dh    String
  auth      String
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  @@index([adminId])
}

/// Unified, multi-actor immutable system audit log
model AuditLog {
  id             String      @id @default(cuid())

  // Multi-actor accountability
  adminId        String?
  admin          AdminUser?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  vendorId       String?
  vendor         VendorUser? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  action         String
  entityType     String
  entityId       String
  actorName      String      @default("")
  actorRole      String      @default("")
  previousStatus String?
  newStatus      String?
  note           String?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
  @@index([vendorId])
  @@index([createdAt])
}

model JobPosting {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  department     String           @default("")
  location       String           @default("")
  employmentType String           @default("Full-time")
  description    String           @default("")
  requirements   String[]         @default([])
  benefits       String[]         @default([])
  isRemote       Boolean          @default(false)
  isPublished    Boolean          @default(false)
  postedAt       DateTime         @default(now())
  sortOrder      Int              @default(0)

  createdById    String?
  createdBy      AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  applications   JobApplication[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  deletedAt      DateTime?        // Soft Deletion

  @@index([isPublished, sortOrder])
  @@index([deletedAt])
}

model JobApplication {
  id           String     @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)

  fullName     String
  email        String
  phone        String     @default("")
  cvFileName   String
  cvFileUrl    String
  cvMimeType   String     @default("application/pdf")

  createdAt    DateTime   @default(now())
  deletedAt    DateTime?  // Soft Deletion

  @@index([jobPostingId])
  @@index([deletedAt])
}

model HeroSlide {
  id               String    @id @default(cuid())
  badge            String    @default("Architecture & Design")
  title1           String
  title2           String
  description      String
  imageUrl         String
  primaryBtnText   String?   @default("Explore Works")
  primaryBtnLink   String?   @default("#projects")
  secondaryBtnText String?   @default("E-Vendor Registration")
  secondaryBtnLink String?   @default("/enquire/verify")
  sortOrder        Int       @default(0)
  isActive         Boolean   @default(true)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  deletedAt        DateTime? // Soft Deletion

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model ClientPartner {
  id         String    @id @default(cuid())
  name       String
  logoUrl    String
  industry   String    @default("General")
  websiteUrl String?
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime? // Soft Deletion

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model Project {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  category     String         @default("Commercial Architecture")
  serviceSlugs String[]       @default([]) // Links to services e.g. "cladding-works", "steel-metal-works"
  client       String         @default("")
  location     String         @default("Riyadh, KSA")
  year         String         @default("2024")
  status       String         @default("Completed") // "Completed" | "In Progress" | "Upcoming"
  description  String         @default("")
  coverImage   String         @default("")
  scope        String[]       @default([])
  sortOrder    Int            @default(0)
  isActive     Boolean        @default(true)

  gallery      GalleryImage[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  deletedAt    DateTime?      // Soft Deletion

  @@index([slug])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model GalleryImage {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl     String
  caption      String    @default("")
  serviceSlugs String[]  @default([]) // Explicit services connected to this photo
  isCover      Boolean   @default(false)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime? // Soft Deletion

  @@index([projectId, sortOrder])
  @@index([isActive])
  @@index([deletedAt])
}

model Service {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String    @default("")
  longDescription String    @default("")
  image           String    @default("")
  iconName        String    @default("Wrench")
  features        String[]  @default([])
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  deletedAt       DateTime? // Soft Deletion

  @@index([slug])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

// =========================================================================
// 8. FILE MANAGER & EXPLORER (Cloudflare R2 Backed)
// =========================================================================

enum ManagedFileType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

model ManagedFolder {
  id          String          @id @default(cuid())
  name        String
  slug        String
  color       String?         @default("indigo") // visual badge color: indigo, emerald, amber, rose, blue, purple
  parentId    String?
  parent      ManagedFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders  ManagedFolder[] @relation("FolderHierarchy")

  files       ManagedFile[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  deletedAt   DateTime?

  @@unique([name, parentId, deletedAt])
  @@index([parentId])
  @@index([deletedAt])
}

model ManagedFile {
  id           String          @id @default(cuid())
  folderId     String?
  folder       ManagedFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  name         String          // Display name (user editable)
  originalName String          // Original uploaded filename
  fileUrl      String          // Public CDN URL (https://pub-....r2.dev/file-manager/...)
  storageKey   String          // R2 storage key (file-manager/...)
  fileType     ManagedFileType @default(OTHER)
  mimeType     String          // e.g. image/webp, video/mp4, application/pdf
  sizeBytes    BigInt          @default(0)
  extension    String          @default("")
  description  String?
  tags         String[]        @default([])

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  deletedAt    DateTime?

  @@index([folderId])
  @@index([fileType])
  @@index([deletedAt])
}

