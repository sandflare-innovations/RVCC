# Unified API (server-only — never expose to the browser)
# Host only — do NOT add /enquire, /admin, or /vendor
API_URL=https://rvcc-api.rvcc.workers.dev

# Cloudflare R2 asset / PDF CDN
NEXT_PUBLIC_ASSET_CDN_URL=https://pub-placeholder.r2.dev
NEXT_PUBLIC_PDF_CDN_URL=https://pub-placeholder.r2.dev

# --- Public hosts (no trailing slash) ---
NEXT_PUBLIC_SITE_URL=https://rvcc-enquiry.vercel.app
NEXT_PUBLIC_VENDOR_PORTAL_URL=https://rvcc-vendor.vercel.app
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://rvcc-admin.vercel.app

# 4-digit document download PIN (server-only)
DOC_PASSWORD=1234

# Optional Upstash Redis — shared session cache (admin + vendor only)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"