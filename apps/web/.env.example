# Cloudflare PDF CDN
NEXT_PUBLIC_PDF_CDN_URL=https://rvcc-pdf-cdn.rvcc.workers.dev

# --- Admin / agent portal (Prisma runs in-process on this app host) ---

# Required for admin and agent authentication — Prisma connects to Postgres
# directly from the Next.js host for these portals (not proxied via a Worker).
# Without this, admin and agent login will 500.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rvcc?sslmode=require"

# Used only by the test suite (package.json's test:db:push script). Put this
# in apps/web/.env.test (gitignored), not here — never commit a real test DB URL.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rvcc_test?sslmode=require"

# --- Enquire / supplier registration ---

# Cloudflare enquire Worker owns Postgres + SMTP (Hyperdrive / secrets) for
# the enquire flow specifically. Next.js is BFF only for enquire — never put
# SMTP credentials or an enquire-specific DATABASE_URL on the app host.
ENQUIRE_WORKER_URL=https://rvcc-enquire-api.YOUR_SUBDOMAIN.workers.dev
ENQUIRE_API_SECRET=generate-a-long-random-secret
