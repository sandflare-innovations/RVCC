# Cloudflare PDF CDN
NEXT_PUBLIC_PDF_CDN_URL=https://rvcc-pdf-cdn.rvcc.workers.dev

# --- Public hosts (no trailing slash) ---
# Local: http://localhost:3000 | http://localhost:3001 | http://localhost:3002
NEXT_PUBLIC_SITE_URL=https://rvcc-prod.vercel.app
NEXT_PUBLIC_VENDOR_PORTAL_URL=https://rvcc-app.vercel.app
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://rvcc-admin.vercel.app

# --- Enquire / supplier registration ---
ENQUIRE_WORKER_URL=https://rvcc-enquire-api.rvcc.workers.dev
ENQUIRE_API_SECRET=generate-a-long-random-secret

# Required for public careers reads (and local enquire fallback when worker unset)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rvcc?sslmode=require"
