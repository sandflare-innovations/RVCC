{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_PDF_CDN_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_VENDOR_PORTAL_URL",
    "NEXT_PUBLIC_ADMIN_PORTAL_URL",
    "ENQUIRE_WORKER_URL",
    "ENQUIRE_API_SECRET",
    "DATABASE_URL",
    "ADMIN_API_URL",
    "ADMIN_API_SECRET",
    "VENDOR_API_URL",
    "VENDOR_API_SECRET",
    "VENDOR_PORTAL_URL",
    "DATABASE_URL_TEST"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!**/public/pdf/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
